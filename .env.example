# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gemini-3.5-flash-lite

# Optional. Set this to use any OpenAI-compatible endpoint, for example Google
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# If the model name starts with "gemini", the Gemini endpoint is selected
# automatically, so this line can stay commented out.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
